      {
        "name": "periwinkle",
        "value": {
          "light": "#4F57D6"
        },
        "usage": "The one ink: wordmark, drawings, roast names and all text on paper (5.8:1 on paper)."
      },
      {
        "name": "navy",
        "value": {
          "light": "#1E2366"
        },
        "usage": "Text on mist or on pastels when extra contrast is needed."
      },
      {
        "name": "blush",
        "value": {
          "light": "#FFB8CD"
        },
        "usage": "daydream highlighter underline. Never for text."
      },
      {
        "name": "butter",
        "value": {
          "light": "#FFE066"
        },
        "usage": "the usual highlighter underline. Never for text."
      },
      {
        "name": "lilac",
        "value": {
          "light": "#CFC6FF"
        },
        "usage": "late show highlighter underline. Never for text."
      }
