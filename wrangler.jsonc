{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "doodle",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Only the signup endpoint runs code; everything else is served as files.
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // Kit form id (a number, as a string). Empty means signups are off and the
    // form says so. KIT_API_KEY is a secret: npx wrangler secret put KIT_API_KEY
    "KIT_FORM_ID": ""
  },
  // Needs doodlecoffee.shop active as a zone in this Cloudflare account first
  // (Porkbun nameservers pointed at Cloudflare). Wrangler creates the DNS record.
  // www redirects to the bare domain with a Cloudflare redirect rule (see README).
  "routes": [{ "pattern": "doodlecoffee.shop", "custom_domain": true }]
}
